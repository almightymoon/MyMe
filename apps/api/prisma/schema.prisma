generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GoalCategory {
  financial
  career
  education
  fitness
  health
  personalDevelopment
  business
  travel
  custom
}

enum GoalPriority {
  low
  medium
  high
  critical
}

enum GoalStatus {
  active
  paused
  completed
  archived
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String?  @unique
  displayName  String
  timezone     String   @default("UTC")
  currencyCode String   @default("PKR") @db.VarChar(3)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  goals        Goal[]
}

model Goal {
  id                 String              @id @default(uuid()) @db.Uuid
  userId             String              @db.Uuid
  name               String
  description        String              @default("")
  category           GoalCategory
  customCategoryName String?
  priority           GoalPriority        @default(medium)
  status             GoalStatus          @default(active)
  /// Whole-number minor units (e.g. paisa). Stored as Decimal(30,0) — never IEEE float.
  targetAmountMinor  Decimal?            @db.Decimal(30, 0)
  currentAmountMinor Decimal?            @db.Decimal(30, 0)
  currencyCode       String?             @db.VarChar(3)
  deadline           DateTime
  progressPercent    Float               @default(0)
  notes              String              @default("")
  archivedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones         GoalMilestone[]
  progressEntries    GoalProgressEntry[]

  @@index([userId])
  @@index([status])
  @@index([deadline])
  @@index([userId, status])
}

model GoalMilestone {
  id          String    @id @default(uuid()) @db.Uuid
  goalId      String    @db.Uuid
  title       String
  description String?
  targetDate  DateTime?
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  goal        Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
}

model GoalProgressEntry {
  id                      String   @id @default(uuid()) @db.Uuid
  goalId                  String   @db.Uuid
  previousProgressPercent Float
  newProgressPercent      Float
  previousAmountMinor     Decimal? @db.Decimal(30, 0)
  newAmountMinor          Decimal? @db.Decimal(30, 0)
  note                    String?
  createdAt               DateTime @default(now())
  goal                    Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@index([goalId, createdAt])
}
