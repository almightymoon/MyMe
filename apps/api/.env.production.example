# Copy to /etc/memy/api.env on the VPS. Never commit real values.
NODE_ENV=production
API_PORT=3000
API_GLOBAL_PREFIX=api/v1
API_PUBLIC_URL=https://api.example.invalid/api/v1
CORS_ORIGINS=https://www.example.invalid

DATABASE_URL=postgresql://memy:change-me@postgres:5432/memy?schema=public

JWT_ACCESS_SECRET=replace-with-32-plus-character-secret
REFRESH_TOKEN_PEPPER=replace-with-pepper

GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# Optional. Creates the first operator if AdminUser is empty.
# ADMIN_BOOTSTRAP_EMAIL=you@example.com
# ADMIN_BOOTSTRAP_PASSWORD=replace-with-12-plus-chars

OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=memy-private
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_SIGNED_URL_SECONDS=300

LOG_LEVEL=info
SUPPORT_EMAIL=
ACCOUNT_DELETION_RETENTION_DAYS=30
BACKUP_PATH=/var/backups/memy
