# Replace MEMY_WWW_HOST and MEMY_API_HOST through the compose environment.
# Do not hardcode a production domain until the owner confirms it.

{$MEMY_WWW_HOST} {
	encode gzip
	root * /srv/www
	file_server
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
	}
}

{$MEMY_API_HOST} {
	encode gzip
	reverse_proxy api:3000
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
	}
	request_body {
		max_size 10MB
	}
}
