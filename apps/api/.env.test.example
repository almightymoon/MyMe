# Isolated E2E / automated test database — never point at development `memy`.
# Copy to `.env.test` locally (gitignored). Never commit real secrets.
#
# NestJS runtime validates DATABASE_URL + application settings only.
# Docker Compose POSTGRES_* values are infrastructure-only (see docker-compose.yml).

NODE_ENV=test

API_PORT=3001
API_GLOBAL_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000

DEV_USER_ID=00000000-0000-4000-8000-000000000001
DEV_USER_EMAIL=emma@example.com
DEV_USER_DISPLAY_NAME="Emma Chen"
DEV_USER_TIMEZONE=Asia/Karachi
DEV_USER_CURRENCY=PKR

# Preferred E2E URL — database name MUST end with `_test`
DATABASE_URL_TEST=postgresql://memy:memy_dev_password@localhost:5433/memy_test?schema=public

# Prisma also reads DATABASE_URL; for local E2E prepare this is set to
# DATABASE_URL_TEST only after the safety guard passes.
DATABASE_URL=postgresql://memy:memy_dev_password@localhost:5433/memy_test?schema=public

# Development URL used only for inequality checks (must differ from DATABASE_URL_TEST)
DEV_DATABASE_URL=postgresql://memy:memy_dev_password@localhost:5433/memy?schema=public
