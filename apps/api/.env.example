# Application
NODE_ENV=development
API_PORT=3000
API_GLOBAL_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080

# Development user (DevAuthGuard only — never enable in production)
DEV_USER_ID=00000000-0000-4000-8000-000000000001
DEV_USER_EMAIL=emma@example.com
DEV_USER_DISPLAY_NAME=Emma Chen
DEV_USER_TIMEZONE=Asia/Karachi
DEV_USER_CURRENCY=PKR

# PostgreSQL (Docker Compose)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=memy
POSTGRES_USER=memy
POSTGRES_PASSWORD=memy_dev_password

# Prisma
DATABASE_URL=postgresql://memy:memy_dev_password@localhost:5433/memy?schema=public

# E2E / automated tests must use a separate database (see .env.test.example)
# DATABASE_URL_TEST=postgresql://memy:memy_dev_password@localhost:5433/memy_test?schema=public
# DEV_DATABASE_URL=postgresql://memy:memy_dev_password@localhost:5433/memy?schema=public
